SPRING_PROFILES_ACTIVE=prod
PORT=8080

# Frontend Vercel URL (separar múltiples por coma)
CORS_ALLOWED_ORIGINS=https://tu-frontend.vercel.app
APP_BASE_URL=https://tu-frontend.vercel.app

# DB Neon (externa)
DB_URL=jdbc:postgresql://ep-xxxxxx-pooler.us-east-1.aws.neon.tech:5432/neondb?sslmode=require&channelBinding=require
DB_USERNAME=neondb_owner
DB_PASSWORD=tu_password_neon

# Seguridad (requerido)
JWT_SECRET=REEMPLAZAR_CON_SECRETO_LARGO_256_BITS
ENCRYPTION_MASTER_KEY=REEMPLAZAR_CON_BASE64_DE_32_BYTES

# Opcionales (si usas integraciones)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
GEMINI_API_KEY=
GROQ_API_KEY=
